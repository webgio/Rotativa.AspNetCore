<?xml version="1.0" encoding="utf-8"?>
<!-- Used to restore the DemoApp against a locally packed Rotativa.AspNetCore (see run-tests.sh / Dockerfile).
     Rotativa.AspNetCore comes only from artifacts/packages; everything else from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Rotativa.AspNetCore" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
